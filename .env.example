# Configurar estas variáveis no painel da hospedagem.
# Para uso local, exporte-as no shell: o Django não carrega .env automaticamente.
DJANGO_SETTINGS_MODULE=barber.production
SECRET_KEY=
DATABASE_URL=
ALLOWED_HOSTS=seu-sistema.exemplo.com
CSRF_TRUSTED_ORIGINS=https://seu-sistema.exemplo.com
# Ative somente se o proxy HTTPS da hospedagem remover cabeçalhos enviados pelo cliente.
TRUST_PROXY_HTTPS=0
PORT=8000

# Consultoria com IA: escolha openai ou gemini. A chave fica somente no Django.
AI_PROVIDER=openai
# Em branco, utiliza o modelo padrão do provedor configurado em settings.py.
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_REQUESTS_PER_HOUR=10
AI_COOLDOWN_SECONDS=30
